DJANGO_DEBUG=False
DJANGO_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
DJANGO_ALLOWED_HOSTS=api.yourapp.com
DJANGO_FRONTEND_ORIGINS=https://yourapp.com,https://www.yourapp.com

# only needed if frontend + API are on different subdomains of yourapp.com
DJANGO_COOKIE_DOMAIN=.yourapp.com

SMS_IR_API_KEY=your-key
SMS_IR_LINE_NUMBER=000000000

# Database: sqlite | postgresql
DB_ENGINE=sqlite

# PostgreSQL (used when DB_ENGINE=postgresql)
DB_NAME=program
DB_USER=admin
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60