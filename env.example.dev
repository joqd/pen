DJANGO_DEBUG=True
DJANGO_SECRET_KEY=dev-secret-key-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_FRONTEND_ORIGINS=http://localhost:3000

# leave unset in dev — subdomains aren't in play locally
# DJANGO_COOKIE_DOMAIN=

SMS_IR_API_KEY=your-key
SMS_IR_LINE_NUMBER=000000000

# Database: sqlite | postgresql
DB_ENGINE=sqlite

# PostgreSQL (used when DB_ENGINE=postgresql)
DB_NAME=program
DB_USER=admin
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60