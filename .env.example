DJANGO_DEBUG=True
DJANGO_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_FRONTEND_ORIGINS=https://yourapp.com,https://www.yourapp.com,http://localhost:3000

# set only in prod
# only needed if frontend + API are on different subdomains of yourapp.com
# DJANGO_COOKIE_DOMAIN=.yourapp.com

# Seo stuff
SITE_URL=
SITE_NAME=
SEO_PRICE_CURRENCY=IRT
SEO_SOCIAL_LINKS=

# OTP service
SMS_IR_API_KEY=YOUR_SMS_IR_API_KEY
SMS_IR_LINE_NUMBER=YOUR_SMS_IR_LINE_NUMBER

# Database: sqlite | postgresql
DB_ENGINE=sqlite

# PostgreSQL (used when DB_ENGINE=postgresql)
DB_NAME=program
DB_USER=admin
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Deployment
DOCKERHUB_USERNAME=rodxa
IMAGE_NAME=pen
IMAGE_TAG=latest
APP_CONTAINER_NAME=pen
HOST_PORT=8000