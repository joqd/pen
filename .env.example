DJANGO_DEBUG=True
DJANGO_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_FRONTEND_ORIGINS=https://yourapp.com,https://www.yourapp.com,http://localhost:3000

# set only in prod
# only needed if frontend + API are on different subdomains of yourapp.com
# DJANGO_COOKIE_DOMAIN=.yourapp.com

# Seo stuff
SITE_URL=
SITE_NAME=
SEO_PRICE_CURRENCY=IRT
SEO_SOCIAL_LINKS=

# OTP service
SMS_IR_API_KEY=YOUR_SMS_IR_API_KEY
SMS_TEMPLATE_ID=138344
SMS_IR_LINE_NUMBER=YOUR_SMS_IR_LINE_NUMBER

# Database: sqlite | postgresql
DB_ENGINE=sqlite

# PostgreSQL (used when DB_ENGINE=postgresql)
DB_NAME=program
DB_USER=admin
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Storage / Do not set if you want to use /media directory
PARSPACK_BUCKET_NAME=
PARSPACK_ACCESS_KEY=
PARSPACK_SECRET_KEY=
PARSPACK_ENDPOINT_URL=
PARSPACK_MEDIA_PREFIX=
PARSPACK_REGION=ir

# Payment
CHECKOUT_CALLBACK_BASE_URL=https://api.starboy.ir
FRONTEND_BASE_URL=https://starboy.ir

AQAYEPARDAKHT_PIN=

# Celery / Redis (broker + result backend share this connection, on db 0 and 1)
REDIS_URL=redis://127.0.0.1:6379
CHECKOUT_EXPIRE_MINUTES=15

# Deployment
HOST_PORT=8000